# Copy to .env on the VPS, fill in, and `docker compose up -d`.

# Must match WG_VPS_IP from the Pi's compose/.env (default 10.50.0.2).
WG_VPS_IP=10.50.0.2

# Local-only stub_status URL on the VPS. Default works with the
# example nginx-stub-status.conf in this folder.
NGINX_STUB_URL=http://host.docker.internal/stub_status

# Read-only Postgres DSN for postgres_exporter. See README.md for the
# SQL to create the `pg_monitor` role. Format:
#   postgresql://user:password@host:port/dbname?sslmode=disable
POSTGRES_EXPORTER_DSN=postgresql://pg_monitor:CHANGE_ME@host.docker.internal:5432/postgres?sslmode=disable
