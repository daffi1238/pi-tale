# VPS-side environment for pi-tale exporters.
#
# Used by docker-compose.yml in this folder. Drop this file as-is on
# any VPS that peers with the Pi's WireGuard gateway and shares the
# 10.0.0.0/24 overlay.
#
# This file is INTENTIONALLY tracked in git: it contains only the
# overlay address, which is non-sensitive (RFC1918, only meaningful
# inside the tunnel). If you later add POSTGRES_EXPORTER_DSN here, do
# NOT commit that — it carries a real password. Keep secrets in a
# sibling .env.local (gitignored) and load with
# `docker compose --env-file .env --env-file .env.local up -d`.

# VPS address inside the WireGuard overlay. Must match the WG_VPS_IP
# the Pi's wireguard_gateway DNATs to (compose/.env on the Pi). Verify
# on the VPS with: `ip -br addr show wg0`.
WG_VPS_IP=10.0.0.1
