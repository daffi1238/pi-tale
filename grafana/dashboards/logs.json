        "definition": "label_values(host)",
        "query": { "label": "host", "stream": "", "type": 1 },
        "refresh": 2,
        "regex": "",
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".+",
        "current": { "selected": true, "text": ["All"], "value": ["$__all"] },
        "options": [],
        "hide": 0
      },
      {
        "name": "audit_key",
        "label": "Audit key",
        "type": "custom",
        "query": "uploads,nginx_conf,ssh_conf,ssh_keys,stack_env",
        "current": { "selected": true, "text": ["All"], "value": ["$__all"] },
        "options": [
          { "selected": true, "text": "All", "value": "$__all" },
          { "selected": false, "text": "uploads", "value": "uploads" },
