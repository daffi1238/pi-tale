        { "refId": "W", "datasource": { "type": "prometheus", "uid": "pitale-prometheus" }, "expr": "nginx_connections_writing{job=\"vps_nginx\"}", "legendFormat": "writing" },
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "pitale-prometheus" }, "expr": "nginx_connections_waiting{job=\"vps_nginx\"}", "legendFormat": "waiting" }
