      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "pitale-prometheus" }, "expr": "rate(nginx_http_requests_total{job=\"vps_nginx\"}[5m])", "legendFormat": "req/s" }
      ],
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "single", "sort": "none" } },
