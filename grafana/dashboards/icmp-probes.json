{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "Liveness and latency of every ICMP target scraped by the blackbox_icmp job. Driven by file_sd in prometheus/targets/blackbox-icmp-*.yml.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Targets UP",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "pitale-prometheus" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "pitale-prometheus" },
          "expr": "count(probe_success{job=~\"blackbox_icmp.*\"} == 1) OR vector(0)",
          "instant": true,
          "legendFormat": "UP"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "value_and_name",
        "orientation": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          },
          "mappings": []
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Targets DOWN",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "pitale-prometheus" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "pitale-prometheus" },
          "expr": "count(probe_success{job=~\"blackbox_icmp.*\"} == 0) OR vector(0)",
          "instant": true,
          "legendFormat": "DOWN"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "value_and_name",
        "orientation": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          },
          "mappings": []
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Total targets",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "pitale-prometheus" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "pitale-prometheus" },
          "expr": "count(probe_success{job=~\"blackbox_icmp.*\"})",
          "instant": true,
          "legendFormat": "Total"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "value_and_name",
        "orientation": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "blue", "value": null }]
          },
          "mappings": []
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Avg RTT (UP targets)",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "pitale-prometheus" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "pitale-prometheus" },
          "expr": "avg(probe_icmp_duration_seconds{job=~\"blackbox_icmp.*\",phase=\"rtt\"} and on(instance) probe_success{job=~\"blackbox_icmp.*\"} == 1)",
          "instant": true,
          "legendFormat": "RTT"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "textMode": "value",
        "orientation": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 2,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.05 },
              { "color": "red", "value": 0.2 }
            ]
          },
          "mappings": []
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "type": "state-timeline",
      "title": "Liveness per target",
      "description": "Green = ICMP reply received, red = no reply during the scrape.",
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "pitale-prometheus" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "pitale-prometheus" },
          "expr": "probe_success{job=~\"blackbox_icmp.*\", instance=~\"$instance\"}",
          "legendFormat": "{{instance}}"
        }
      ],
      "options": {
        "mergeValues": true,
        "showValue": "never",
        "alignValue": "left",
        "rowHeight": 0.9,
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": false },
        "tooltip": { "mode": "single", "sort": "none" }
      },
      "fieldConfig": {
        "defaults": {
          "custom": { "lineWidth": 0, "fillOpacity": 80 },
          "mappings": [
            { "type": "value", "options": { "0": { "text": "DOWN", "color": "red", "index": 0 } } },
            { "type": "value", "options": { "1": { "text": "UP",   "color": "green", "index": 1 } } }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          },
          "color": { "mode": "thresholds" }
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "RTT per target",
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 13 },
      "datasource": { "type": "prometheus", "uid": "pitale-prometheus" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "pitale-prometheus" },
          "expr": "probe_icmp_duration_seconds{job=~\"blackbox_icmp.*\",phase=\"rtt\", instance=~\"$instance\"}",
          "legendFormat": "{{instance}}"
        }
      ],
      "options": {
        "legend": { "displayMode": "table", "placement": "right", "showLegend": true, "calcs": ["mean", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 2,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 1,
            "fillOpacity": 8,
            "spanNulls": false,
            "showPoints": "never",
            "axisPlacement": "auto"
          },
          "color": { "mode": "palette-classic" },
          "mappings": []
        },
        "overrides": []
      }
    },
    {
      "id": 7,
      "type": "table",
      "title": "Current status",
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 13 },
      "datasource": { "type": "prometheus", "uid": "pitale-prometheus" },
      "targets": [
        {
          "refId": "STATUS",
          "datasource": { "type": "prometheus", "uid": "pitale-prometheus" },
          "expr": "probe_success{job=~\"blackbox_icmp.*\", instance=~\"$instance\"}",
          "instant": true,
          "format": "table",
          "legendFormat": ""
        },
        {
          "refId": "RTT",
          "datasource": { "type": "prometheus", "uid": "pitale-prometheus" },
          "expr": "probe_icmp_duration_seconds{job=~\"blackbox_icmp.*\",phase=\"rtt\", instance=~\"$instance\"}",
          "instant": true,
          "format": "table",
          "legendFormat": ""
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "job": true,
              "kind": true
            },
            "indexByName": {
              "instance": 0,
              "subnet": 1,
              "Value #STATUS": 2,
              "Value #RTT": 3
            },
            "renameByName": {
              "instance": "Target",
              "subnet": "Subnet",
              "Value #STATUS": "Up",
              "Value #RTT": "RTT"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "align": "auto" },
          "mappings": []
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Up" },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  { "type": "value", "options": { "0": { "text": "DOWN", "color": "red", "index": 0 } } },
                  { "type": "value", "options": { "1": { "text": "UP",   "color": "green", "index": 1 } } }
                ]
              },
              { "id": "custom.cellOptions", "value": { "type": "color-background", "mode": "basic" } },
              { "id": "custom.width", "value": 90 }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "RTT" },
            "properties": [
              { "id": "unit", "value": "s" },
              { "id": "decimals", "value": 3 }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "footer": { "show": false, "reducer": ["sum"], "fields": "" }
      }
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["pi-tale", "blackbox", "icmp", "network"],
  "templating": {
    "list": [
      {
        "name": "instance",
        "label": "Target",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "pitale-prometheus" },
        "definition": "label_values(probe_success{job=~\"blackbox_icmp.*\"}, instance)",
        "query": { "query": "label_values(probe_success{job=~\"blackbox_icmp.*\"}, instance)", "refId": "StandardVariableQuery" },
        "refresh": 2,
        "regex": "",
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": { "selected": true, "text": ["All"], "value": ["$__all"] },
        "options": [],
        "hide": 0
      },
      {
        "name": "subnet",
        "label": "Subnet",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "pitale-prometheus" },
        "definition": "label_values(probe_success{job=~\"blackbox_icmp.*\"}, subnet)",
        "query": { "query": "label_values(probe_success{job=~\"blackbox_icmp.*\"}, subnet)", "refId": "StandardVariableQuery" },
        "refresh": 2,
        "regex": "",
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": { "selected": true, "text": ["All"], "value": ["$__all"] },
        "options": [],
        "hide": 0
      }
    ]
  },
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
  "timezone": "",
  "title": "ICMP Probes",
  "uid": "pitale-icmp-probes",
  "version": 1,
  "weekStart": ""
}
