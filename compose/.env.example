# pi-tale — environment variables.
#
# Copy this file to compose/.env and fill in the values you need.
# Everything in compose/.env is git-ignored.
#
#   cp compose/.env.example compose/.env
#   nano compose/.env

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------

# Where bind-mounted data lives. The compose files use ../data by default.
# In production this directory should sit on the SSD (e.g. a symlink
# /home/<user>/pi-tale/data -> /mnt/datos/pi-tale/data), never on the
# microSD card.
DATA_DIR=./data

# ---------------------------------------------------------------------------
# Hardening — port bindings
# ---------------------------------------------------------------------------
#
# Where Docker publishes the UI/metric ports on the host. Three modes:
#
#   0.0.0.0       all host interfaces (default, comfortable for homelab)
#   127.0.0.1     localhost only — UIs reachable only via SSH tunnel
#                 (`ssh -L 3000:localhost:3000 pi`). Recommended if the
#                 Pi is on an untrusted LAN or you don't want to rely on
#                 the LAN being trusted.
#   <LAN IP>      e.g. 192.168.1.10 — only your LAN interface, never the
#                 WiFi guest VLAN / VPN interfaces / etc. Useful on Pis
#                 with multiple NICs.
#
# Defense in depth: this applies to Grafana, Prometheus, Alertmanager,
# Loki, cAdvisor and Uptime Kuma. WireGuard runs in its own container
# so it is unaffected.
BIND_HOST=0.0.0.0

# ---------------------------------------------------------------------------
# Prometheus
# ---------------------------------------------------------------------------

# How long to keep metrics on disk and what soft size cap to enforce.
# On a 60 GB SSD with default scrape rates 15d / 10GB is comfortable.
PROMETHEUS_RETENTION=15d
PROMETHEUS_RETENTION_SIZE=10GB
PROMETHEUS_PORT=9090

# ---------------------------------------------------------------------------
# Alertmanager
# ---------------------------------------------------------------------------

ALERTMANAGER_PORT=9093

# Telegram receiver. Both variables below are read by
# `sudo make telegram-setup`, which writes the token to
# data/alertmanager/secrets/ (alertmanager reads via bot_token_file) and
# renders alertmanager/alertmanager.yml.tmpl into
# data/alertmanager/runtime/alertmanager.yml with the chat id
# substituted.
#
# End-to-end setup:
#   1. Create a bot with @BotFather, copy the token below.
#   2. Add the bot to the destination chat (group OR DM), send a message
#      to it from any human account.
#   3. Find the chat id:
#        curl -s "https://api.telegram.org/bot<TOKEN>/getUpdates" \
#          | python3 -c 'import json,sys; [print(c["id"]) for c in
#            (m["message"]["chat"] for m in json.load(sys.stdin)["result"])]'
#      Group ids are negative (`-100…` for supergroups). A positive id
#      means the bot DMs that user privately — also valid.
#   4. Set both below.
#   5. Apply:    sudo make telegram-setup
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# SMTP receiver for email alerts. Works with any provider; values below
# show Gmail SMTP with an app password as an example. To enable:
#   1. Fill these out.
#   2. `sudo make secrets-setup` writes SMTP_PASSWORD to
#      data/alertmanager/secrets/smtp_password (alertmanager reads it
#      via `smtp_auth_password_file` so it never enters committed YAML).
#   3. Uncomment the SMTP block in alertmanager/alertmanager.yml.tmpl
#      and the `email` receiver, then re-run `sudo make telegram-setup`
#      (it renders the template). Or hand-render and reload alertmanager.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
ALERT_EMAIL_TO=

# ---------------------------------------------------------------------------
# Grafana
# ---------------------------------------------------------------------------

GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
# REQUIRED. The value below is NEVER passed directly to the Grafana
# container — `sudo make secrets-setup` reads it from here and writes it
# to data/grafana/secrets/admin_password, which the container mounts and
# reads via Grafana's native `GF_SECURITY_ADMIN_PASSWORD__FILE`. So:
#
#   1. Set this value.
#   2. `sudo make secrets-setup`
#   3. `make up`  (or `docker compose ... restart grafana` if already up)
#
# Without step 2 Grafana will fail to start: it expects a file at
# /etc/grafana/secrets/admin_password and will not fall back to a
# plain env var.
GRAFANA_ADMIN_PASSWORD=CHANGE_ME
# How Grafana advertises itself in emailed links etc.
GRAFANA_ROOT_URL=http://localhost:3000
GRAFANA_LOG_LEVEL=warn

# ---------------------------------------------------------------------------
# Loki
# ---------------------------------------------------------------------------

LOKI_PORT=3100

# ---------------------------------------------------------------------------
# cAdvisor
# ---------------------------------------------------------------------------

# Bound to 8081 on the host (Grafana already uses 3000, common services
# may use 8080).
CADVISOR_PORT=8081

# ---------------------------------------------------------------------------
# Uptime Kuma (compose/extras.yml)
# ---------------------------------------------------------------------------

UPTIME_KUMA_PORT=3001

# Future use: once Prometheus is wired to scrape Kuma's /metrics endpoint,
# create an API key from the Kuma UI (Settings → API Keys) and paste it
# here. Not used yet — leave commented.
# UPTIME_KUMA_API_KEY=

# ---------------------------------------------------------------------------
# UniFi (filled in once you add compose/unifi.yml)
# ---------------------------------------------------------------------------

# UNIFI_CONTROLLER_HOST=
# UNIFI_USERNAME=
# UNIFI_PASSWORD=
# UNIFI_SITE=default

# ---------------------------------------------------------------------------
# WiFi RF probe (compose/probes.yml — exporters/wifi)
# ---------------------------------------------------------------------------

# Interface dedicated to scanning. wlan1 is the Alfa AWUS036ACH (RTL8812AU)
# installed by bootstrap/wifi-driver-setup.sh; wlan0 is the Pi's built-in
# Broadcom radio. The exporter brings the interface `up` if it isn't.
WIFI_IFACE=wlan1

# Scan cadence. Matches the global Prometheus scrape interval so each
# scrape sees fresh data.
WIFI_SCAN_INTERVAL=30
WIFI_SCAN_TIMEOUT=20

# Comma-separated fnmatch globs. SSIDs that match any pattern are exported;
# the rest are silently dropped. Leave empty to export every visible BSSID
# (will increase cardinality — only do this temporarily for diagnosis).
#
# `*` matches both bands of the same physical network (the AP usually
# advertises distinct SSIDs per radio, e.g. -5G suffix).
WIFI_SSID_PATTERNS=MOVISTAR-WIFI6-C738*,vodafone317B*,HCN-Wifi*

# Set to 1 if you want to publish the dashboard without leaking the
# operator's SSID. The exporter then exports sha256(ssid)[:12] instead.
WIFI_HASH_SSID=0

# Where the exporter binds on the host (it runs with network_mode: host).
# The default is Docker's docker0 bridge gateway (172.17.0.1) — exactly
# what `host-gateway` resolves to inside containers connected to the
# pitale bridge, so Prometheus reaches the exporter at
# `host.docker.internal:9116` while the LAN cannot see it. If your
# Docker daemon was configured with a non-default docker0 subnet,
# check `docker network inspect bridge` and override here. Set to
# 0.0.0.0 if you actually want to scrape from another host (and accept
# that the port is then exposed on every interface).
WIFI_LISTEN_HOST=172.17.0.1
WIFI_LISTEN_PORT=9116

# ---------------------------------------------------------------------------
# WireGuard tunnel to the VPS
# ---------------------------------------------------------------------------
#
# The Pi monitors VPS exporters over a private overlay (default
# 10.50.0.0/24). The Pi is the WireGuard client, the VPS is the
# listener. The actual tunnel config (keys, endpoint, AllowedIPs) lives
# in data/wireguard/wg0.conf — see data/wireguard/wg0.conf.example.
#
# The variables below are NOT used by wg-quick. They configure the DNAT
# rules the gateway entrypoint installs, so they must match the IP your
# wg0.conf assigns to the Pi (Address=) and the VPS WG address you want
# to scrape.

# IP the Pi has inside the overlay. Must match the `Address = <ip>/...`
# line in data/wireguard/wg0.conf.
WG_PI_IP=10.50.0.1

# IP of the VPS inside the overlay — destination for the DNAT forwards
# (node_exporter, cadvisor, nginx, postgres on the VPS). The entrypoint
# uses this as VPS_TARGET_IP.
WG_VPS_IP=10.50.0.2

# Port the WireGuard exporter binds on the Pi.
WIREGUARD_LISTEN_PORT=9586

# ---------------------------------------------------------------------------
# TLS terminator (optional — compose/tls.yml)
# ---------------------------------------------------------------------------
#
# Caddy in front of Grafana. The TLS layer is opt-in via `make tls`.
# Two deployment modes, decided by what TLS_HOSTNAME resolves to:
#
#   Real public domain (e.g. monitor.example.com):
#     Caddy auto-issues a Let's Encrypt cert via HTTP-01 on :80. The
#     domain must resolve to your Pi's public IP AND port 80 must be
#     reachable from the internet. Set TLS_EMAIL too — Let's Encrypt
#     uses it for renewal-failure notifications.
#
#   Local hostname or IP (e.g. pi-monitor.local, 192.168.1.10):
#     Caddy falls back to its internal CA. Browsers will warn until you
#     import the Caddy root cert
#     (data/caddy/data/caddy/pki/authorities/local/root.crt).
#
# After enabling TLS you usually also want to lock the plain :3000 path
# behind localhost: set `BIND_HOST=127.0.0.1` above so Grafana publishes
# only on loopback, and `TLS_BIND_HOST=0.0.0.0` so Caddy is the only
# reachable HTTPS entry point.

TLS_HOSTNAME=localhost
TLS_EMAIL=
TLS_BIND_HOST=0.0.0.0

# ---------------------------------------------------------------------------
# SNMP (filled in once you add compose/probes.yml)
# ---------------------------------------------------------------------------

# SNMP_COMMUNITY=public
